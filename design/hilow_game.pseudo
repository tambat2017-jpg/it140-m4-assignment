START hilow_game
    OUTPUT "Enter a lower bound:"
    INPUT lowerBound
    OUTPUT "Enter an upper bound:"
    INPUT upperBound

    WHILE lowerBound >= upperBound
        OUTPUT "The lower bound must be less than the upper bound."
        OUTPUT "Enter a lower bound:"
        INPUT lowerBound
        OUTPUT "Enter an upper bound:"
        INPUT upperBound
    SET targetNumber = GenerateRandomNumber(lowerBound, upperBound)
    REPEAT
        OUTPUT "Enter a guess between the selected bounds:"
        INPUT guess

        WHILE guess < lowerBound OR guess > upperBound
            OUTPUT "That guess is outside the selected bounds."
            OUTPUT "Enter another guess:"
            INPUT guess

        IF guess < targetNumber
            OUTPUT "Your guess is too low."
        ELSE IF guess > targetNumber
            OUTPUT "Your guess is too high."
        ELSE
            OUTPUT "Congratulations! You guessed the correct number."
    UNTIL guess = targetNumber
END hilow_game
